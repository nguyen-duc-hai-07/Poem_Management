<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Refresh tokens moved to Redis; drop the table on databases that already created it -->
    <changeSet id="006-drop-table-refresh-tokens" author="oplearn-base">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="refresh_tokens"/>
        </preConditions>
        <dropTable tableName="refresh_tokens"/>
    </changeSet>

</databaseChangeLog>
